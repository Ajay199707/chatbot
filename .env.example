# Copy this file to .env (or configure keys inside the Desktop Companion Customize dialog)
# For 100% free unlimited local AI with Ollama, no API key is needed.
GEMINI_API_KEY=
GROQ_API_KEY=
GROK_API_KEY=
NVIDIA_API_KEY=
TAVILY_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# -----------------------------------------------------------------------------
# Built-in API Connectors (Optional)
# Configure directly or via Settings -> APIs & Tools -> Built-in API Keys...
# Weather (Open-Meteo works free without a key), Web Search (DuckDuckGo fallback),
# and Maps (OpenStreetMap Nominatim fallback) work even without these keys.
# -----------------------------------------------------------------------------
OPENWEATHER_API_KEY=
NEWSAPI_KEY=
GOOGLE_MAPS_API_KEY=
SQLITE_DB_PATH=
DATABASE_API_URL=
SMTP_HOST=
SMTP_PORT=587
IMAP_HOST=
EMAIL_USER=
EMAIL_PASSWORD=
GOOGLE_CALENDAR_TOKEN=
CALENDAR_ICS_URL=
STRIPE_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
