# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller specification for the standalone AICompanion.exe Windows app."""

from PyInstaller.utils.hooks import collect_data_files

datas = [
    ('assets/app_icon.ico', 'assets'),
    ('static', 'static'),
]
datas += collect_data_files('certifi')

a = Analysis(
    ['desktop_companion.py'],
    pathex=['.'],
    binaries=[],
    datas=datas,
    hiddenimports=['chatbot', 'system_tools', 'certifi'],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[
        'tkinter',
        'unittest',
        'PyQt5',
        'PyQt6',
        'PySide2',
        'wx',
        'gi',
        'IPython',
        'ipykernel',
        'ipywidgets',
        'jupyter',
        'jupyter_core',
        'nbformat',
        'matplotlib',
        'mpl_toolkits',
        'numpy',
        'scipy',
        'pandas',
        'pyarrow',
        'torch',
        'torchvision',
        'torchaudio',
        'tensorflow',
        'onnxruntime',
        'sympy',
        'numba',
        'llvmlite',
        'h5py',
        'lxml',
        'sqlalchemy',
        'openpyxl',
        'fsspec',
        'imageio',
        'imageio_ffmpeg',
        'cv2',
        'PIL',
        'jedi',
        'parso',
        'zmq',
        'pytest',
        'py',
        'rich',
        'setuptools',
        'pkg_resources',
        'wheel',
        'win32com',
        'pythoncom',
        'pywintypes',
        'cryptography',
        'PySide6.QtWebEngineCore',
        'PySide6.QtWebEngineWidgets',
        'PySide6.QtWebEngineQuick',
        'PySide6.Qt3DCore',
        'PySide6.Qt3DRender',
        'PySide6.Qt3DInput',
        'PySide6.Qt3DLogic',
        'PySide6.Qt3DAnimation',
        'PySide6.Qt3DExtras',
        'PySide6.QtMultimedia',
        'PySide6.QtMultimediaWidgets',
        'PySide6.QtQuick',
        'PySide6.QtQuickWidgets',
        'PySide6.QtQml',
        'PySide6.QtCharts',
        'PySide6.QtDataVisualization',
        'PySide6.QtGraphs',
        'PySide6.QtPdf',
